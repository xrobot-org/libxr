PROJECT_NAME = "libxr"
OUTPUT_DIRECTORY = "./doc"
GENERATE_HTML = YES
GENERATE_LATEX = NO
GENERATE_XML = NO
INPUT = "README.md" "driver" "system/linux" "src" "doc"
FILE_PATTERNS = "*.cpp" "*.hpp" "*.h" "*.md"
USE_MDFILE_AS_MAINPAGE = ./README.md
RECURSIVE = YES
EXCLUDE = "cmake" "CMakeLists.txt" "LICENSE" "log.txt" "src/core/print/writer"
EXCLUDE_PATTERNS = "*/cmake/*" "*/doc/html/*" "*/log/*" "*/test/*"
IMAGE_PATH = "./"
OUTPUT_LANGUAGE = English
INPUT_ENCODING = UTF-8
EXTRACT_ALL = NO
EXTRACT_PRIVATE = NO
EXTRACT_STATIC = YES
SOURCE_BROWSER = YES
INLINE_SOURCES = YES
CASE_SENSE_NAMES = NO
GENERATE_TREEVIEW = YES
ENABLE_PREPROCESSING = YES
MACRO_EXPANSION = YES
SEARCHENGINE = YES
WARNINGS = YES
WARN_IF_UNDOCUMENTED = YES
QUIET = NO
WARN_LOGFILE = "doxygen_warnings.log"
GENERATE_MAN = NO
GENERATE_RTF = NO
GENERATE_PERLMOD = NO
DOT_GRAPH_MAX_NODES = 1024
EXPAND_ONLY_PREDEF = YES
PREDEFINED = "__DOXYGEN__" \
    "HAL_ADC_MODULE_ENABLED" \
    "HAL_CAN_MODULE_ENABLED" \
    "HAL_FDCAN_MODULE_ENABLED" \
    "HAL_GPIO_MODULE_ENABLED" \
    "HAL_I2C_MODULE_ENABLED" \
    "HAL_TIM_MODULE_ENABLED" \
    "HAL_SPI_MODULE_ENABLED" \
    "HAL_UART_MODULE_ENABLED" \
    "HAL_PCD_MODULE_ENABLED" \
    "HAL_IWDG_MODULE_ENABLED" \
    "HAL_FLASH_MODULE_ENABLED" \
    "HAL_DAC_MODULE_ENABLED" \
    "USB_OTG_FS" \
    "USB_OTG_HS" \
    "HAVE_WPA_CLIENT" \
    "LIBXR_PRINT_ENABLE_FLOAT=1" \
    "LIBXR_DEFAULT_SCALAR=double"
HAVE_DOT = YES
DOT_IMAGE_FORMAT = svg
SORT_GROUP_NAMES = YES
PROJECT_BRIEF = "Embedded C++ framework for bare-metal, RTOS and Linux"
DISABLE_INDEX = NO
FULL_SIDEBAR = NO

GENERATE_TODOLIST      = NO
GENERATE_TESTLIST      = NO
GENERATE_BUGLIST       = NO
GENERATE_DEPRECATEDLIST = NO

HTML_EXTRA_STYLESHEET  = lib/doxygen-awesome-css/doxygen-awesome.css \
                         lib/doxygen-awesome-css/doxygen-custom/custom.css \
                         lib/doxygen-awesome-css/doxygen-awesome-sidebar-only.css \
                         lib/doxygen-awesome-css/doxygen-awesome-sidebar-only-darkmode-toggle.css \
                         lib/doxygen-awesome-css/doxygen-custom/custom-alternative.css

HTML_EXTRA_FILES       = lib/doxygen-awesome-css/doxygen-awesome-darkmode-toggle.js \
                         lib/doxygen-awesome-css/doxygen-awesome-fragment-copy-button.js \
                         lib/doxygen-awesome-css/doxygen-awesome-paragraph-link.js \
                         lib/doxygen-awesome-css/doxygen-custom/toggle-alternative-theme.js \
                         lib/doxygen-awesome-css/doxygen-awesome-interactive-toc.js \
                         lib/doxygen-awesome-css/doxygen-awesome-tabs.js

HTML_COLORSTYLE        = LIGHT
HTML_HEADER            = doc/header.html

HTML_COLORSTYLE_HUE    = 209
HTML_COLORSTYLE_SAT    = 255
HTML_COLORSTYLE_GAMMA  = 113
